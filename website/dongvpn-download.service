[Unit]
Description=DongVPN password-protected macOS download
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dongvpn-download
Group=ssl-cert
Environment=DONGVPN_WEB_CONFIG=/etc/dongvpn-download.json
Environment=DONGVPN_DOWNLOAD=/srv/dongvpn/DongVPN.dmg
Environment=DONGVPN_WEB_ROOT=/var/www/dongvpn-acme
EnvironmentFile=-/etc/dongvpn-download.env
ExecStart=/usr/bin/python3 /opt/dongvpn-download/server.py
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/dongvpn-download /srv/dongvpn /etc/dongvpn-download/tls
ReadWritePaths=/var/www/dongvpn-acme
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
